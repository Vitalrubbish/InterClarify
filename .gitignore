# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Local configuration and secrets
.env
.env.*
!.env.example

# Experiment outputs and model artifacts
experiments/*
artifacts/
checkpoints/
outputs/
runs/
logs/

# Source manifest generated in place before a cluster job
source_manifest.json
*.ckpt
*.safetensors
*.pt
*.pth

# Cluster run evidence copied back from compute nodes (chain logs, reports)
data/runs/

# Runtime chat history database
data/chat_history.sqlite3

# Local benchmark data staged for A4 acceptance (FDB v1.0 samples, trial audio)
benchmark/

# Audio and transcript captures generated during experiments
*.wav
*.flac
*.mp3
*.jsonl

# LaTeX build intermediates
*.aux
*.log
*.out
*.toc
*.synctex.gz

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/

# Visual Studio Code settings
.vscode/

# Tutorial of using docker image to submit vc tasks
image_use.md

# Huggingface Token
hf_token.txt

# OpenAI Api
openai_api.txt
openai_use.example
.env
*.env

# Independent X-Talk fork checkout. Its commits are tracked in its own repo;
# InterClarify records the selected revision in configs and run manifests.
/xtalk/

# Stage A acceptance reports are curated evidence and stay tracked even though
# they contain *.log and *.jsonl, which are ignored globally above.
!reports/duplex_acceptance/
!reports/duplex_acceptance/**
!reports/duplex_acceptance/**/*.log
!reports/duplex_acceptance/**/*.jsonl

# Only the A4 acceptance reports keep their *.log / *.jsonl exceptions: the
# one-off marker-probe and ASR before/after evidence directories were removed on
# 2026-10-14 (their conclusions live in docs/xtalk_a4_remote_acceptance.md).
